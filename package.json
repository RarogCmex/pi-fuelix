{
  "name": "@rarogcmex/pi-fuelix",
  "version": "0.1.2",
  "description": "fuelix.ai gateway provider for pi — the 98-id chat catalog of a 111-id LiteLLM gateway (Azure OpenAI + Vertex/Anthropic + Google + third-party routes), per-model maxTokensField, /login, an additive /v1/models overlay and an error layer for the gateway's RFC 7807 / {\"detail\"} / 403-entitlement shapes.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RarogCmex/pi-fuelix.git"
  },
  "bugs": {
    "url": "https://github.com/RarogCmex/pi-fuelix/issues"
  },
  "homepage": "https://github.com/RarogCmex/pi-fuelix#readme",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "fuelix",
    "litellm",
    "azure-openai",
    "openai-compat"
  ],
  "scripts": {
    "test": "node --test --import ./test/no-network.ts 'test/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test",
    "live": "node live/check.ts"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
